# Environment every paper run used. Source it before launching a driver:  set -a; . configs/paper.env; set +a
OPTIMIZER_BACKEND=claude_sandbox      # optimizer = Claude Code agent over the cell's evidence sandbox
OPTIMIZER_SANDBOX_VIEW=cell
POISON_NEUTRAL_NAMES=1                # neutral file/skill names (nothing in the victim's view says "poison")
POISON_SB_EARLY_EXIT_FIX=1
POISON_AE_GPTOSS_TOOLFIX=1
POISON_SG_CONTEXT_FIT=1
POISON_T2S_ROLLOUT_ISOLATE=1
SKILLOPT_GATE=tie
QA_BEACON_PLACEMENT=preanswer
QA_BUDGET_FAILURES=graded_ctx
QA_CARRIER_POS=head
QA_EVOLVE_POOL=poison_only
QA_POISON_CLEAN=0
WIKITQ_ANSWER_TOKENS=16384
OFFICEQA_ANSWER_TOKENS=16384
# SkillGrad on WikiTQ / OfficeQA additionally:
# POISON_SG_TASK_FRAME=prompt
