# Copy to .env and fill in; load with:  set -a; . .env; set +a

# Victims: one OpenAI-compatible endpoint serving the backbone names (see configs/models.example.yaml)
BADEVOLVE_BASE_URL=http://localhost:8000/v1
BADEVOLVE_API_KEY=EMPTY
# Optional: route a backbone to another gateway, JSON {model: base_url}
# BADEVOLVE_ENDPOINTS={"qwen3-235b": "http://localhost:8001/v1"}

# Optimizer: Claude Sonnet 4.6 through the Claude Code CLI
BADEVOLVE_OPTIMIZER_PROVIDER=anthropic     # anthropic | bedrock
ANTHROPIC_API_KEY=
# BADEVOLVE_OPTIMIZER_MODEL=claude-sonnet-4-6
# For bedrock: CLAUDE_CODE_USE_BEDROCK=1 and AWS_REGION=...

# OfficeQA is gated on Hugging Face; needed only by scripts/build_officeqa_splits.py
HF_TOKEN=
